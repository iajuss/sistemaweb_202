SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Requisito no painel do Supabase: em Authentication -> Sign In / Providers -> Email,
# a opção "Confirm email" deve ficar DESMARCADA. O cadastro desta aplicação faz login
# logo após o signUp(); com a confirmação de e-mail habilitada, o usuário é criado mas
# fica não confirmado, e o login seguinte falha com "E-mail ou senha inválidos.".
